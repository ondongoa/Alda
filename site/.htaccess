# Clean URLs: redirect old .html addresses to their folder versions
RewriteEngine On
RewriteCond %{THE_REQUEST} \s/+about\.html[\s?] [NC]
RewriteRule ^ /a-propos/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+projets\.html[\s?] [NC]
RewriteRule ^ /projets/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Always serve over HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
